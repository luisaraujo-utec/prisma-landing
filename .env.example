# =========================================================
# PRISMA Landing - Variables de entorno de ejemplo
# Copiar a .env.local (dev), .env.test, .env.production
# Nunca commitear archivos .env con valores reales
# =========================================================

# Ruta base pública. Localmente y en Docker: "/"
# En GitHub Pages: "/<nombre-del-repo>/"
VITE_BASE_PATH=/

# Puerto en el que se expone el contenedor Nginx (docker-compose)
WEB_PORT=8080

# Etiqueta de imagen construida (se usa con --tag)
TAG=latest

# Entorno lógico de la app (informativo; se propaga al label del container)
# Valores esperados: dev | test | staging | prod
APP_ENV=dev
