{
  "name": "prisma-landing",
  "version": "0.1.0",
  "private": true,
  "description": "PRISMA - Plataforma de Revisión Integral de Seguridad y Marcos de Auditorías. Landing pública del proyecto.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host",
